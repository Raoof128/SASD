# Flask Application Configuration
FLASK_APP=backend/app.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-random-secret-key
DEBUG=True

# Database Configuration
DATABASE_URL=postgresql://soar_user:soar_password@localhost:5432/soar_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=soar_db
DB_USER=soar_user
DB_PASSWORD=soar_password

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# API Keys - Threat Intelligence
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
ALIENVAULT_OTX_API_KEY=your_alienvault_otx_api_key_here
MISP_API_KEY=your_misp_api_key_here
MISP_URL=https://your-misp-instance.com

# Email Security APIs
PROOFPOINT_API_KEY=your_proofpoint_api_key_here
PROOFPOINT_API_SECRET=your_proofpoint_api_secret_here
MIMECAST_APP_ID=your_mimecast_app_id_here
MIMECAST_APP_KEY=your_mimecast_app_key_here
MIMECAST_ACCESS_KEY=your_mimecast_access_key_here
MIMECAST_SECRET_KEY=your_mimecast_secret_key_here

# Microsoft Graph API (Azure AD / Exchange)
MICROSOFT_CLIENT_ID=your_azure_app_client_id_here
MICROSOFT_CLIENT_SECRET=your_azure_app_client_secret_here
MICROSOFT_TENANT_ID=your_azure_tenant_id_here

# Active Directory / LDAP
AD_SERVER=ldap://your-ad-server.com
AD_DOMAIN=YOURDOMAIN
AD_USER=admin_user
AD_PASSWORD=admin_password
AD_BASE_DN=DC=yourdomain,DC=com

# Firewall API
FIREWALL_API_URL=https://your-firewall.com/api
FIREWALL_API_KEY=your_firewall_api_key_here

# EDR (Endpoint Detection & Response)
WAZUH_API_URL=https://your-wazuh-server.com:55000
WAZUH_API_USER=wazuh_user
WAZUH_API_PASSWORD=wazuh_password
OSQUERY_API_URL=https://your-osquery-server.com/api

# SIEM Integration
SPLUNK_HOST=your-splunk-server.com
SPLUNK_PORT=8089
SPLUNK_API_KEY=your_splunk_api_key_here
SPLUNK_INDEX=main
ELK_HOST=your-elasticsearch-server.com
ELK_PORT=9200
ELK_API_KEY=your_elasticsearch_api_key_here

# Ticketing Systems
JIRA_URL=https://your-company.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your_jira_api_token_here
JIRA_PROJECT_KEY=SEC
SERVICENOW_INSTANCE=your-instance.service-now.com
SERVICENOW_USERNAME=admin
SERVICENOW_PASSWORD=password

# Communication Channels
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL_SECURITY=#security
SLACK_CHANNEL_INCIDENTS=#incidents

# Email (SMTP)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@company.com
SMTP_PASSWORD=your-email-password
SMTP_FROM=soar-platform@company.com
SMTP_USE_TLS=True

# Application Settings
APP_HOST=0.0.0.0
APP_PORT=5000
MAX_CONTENT_LENGTH=16777216
SESSION_TIMEOUT=3600
LOG_LEVEL=INFO
LOG_FORMAT=json

# Performance & Rate Limiting
API_RATE_LIMIT=100
API_RATE_PERIOD=60
MAX_WORKERS=4
PLAYBOOK_TIMEOUT=300

# Metrics & Monitoring
ENABLE_METRICS=True
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Security Settings
ENABLE_RBAC=True
PASSWORD_MIN_LENGTH=12
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
ENCRYPTION_KEY=your-encryption-key-for-storing-api-keys

# Deployment
ENVIRONMENT=development
WORKERS=4
THREADS=2
